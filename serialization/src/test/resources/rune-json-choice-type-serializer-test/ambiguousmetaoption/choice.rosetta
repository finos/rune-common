namespace serialization.test.passing.ambiguousmetaoption

annotation rootType: <"Mark a type as a root of the rosetta model">

type Foo:
  [metadata key]
  a string (1..1)

choice Inner:
  string
  [metadata scheme]
  int

choice Outer:
  string
  Inner

choice InnerData:
  Foo
  [metadata reference]
  int

choice OuterData:
  Foo
  InnerData

choice InnerA:
  string
  int

choice InnerB:
  string
  date

choice Both:
  InnerA
  InnerB

type Root:
  [rootType]
  outer Outer (0..1)
  outerData OuterData (0..1)
  both Both (0..1)