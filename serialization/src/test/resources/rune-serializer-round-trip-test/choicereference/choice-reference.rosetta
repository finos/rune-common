namespace serialization.test.passing.choicereference

annotation rootType: <"Mark a type as a root of the rosetta model">

type G:
  [metadata key]
  fieldG string (1..1)

type H:
  fieldH string (0..1)
  g G (0..1)
    [metadata reference]
  gs G (0..*)
    [metadata reference]

choice ChoiceWithReferences:
  H
  string

type Root:
  [rootType]
  typeG G (0..1)
  choiceWithReferences ChoiceWithReferences (0..1)
